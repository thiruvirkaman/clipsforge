# .env.example
# Copy to .env and fill in real values. Never commit the real .env file.

# --- Database ---
DB_USER=postgres
DB_PASSWORD=securepassword
DB_NAME=clipforge
DATABASE_URL=postgresql://postgres:securepassword@db:5432/clipforge

# --- Auth / JWT ---
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Frontend / CORS ---
FRONTEND_URL=http://localhost:5173
# Comma-separated list of origins the API accepts CORS requests from.
# Includes both the Dockerized frontend (nginx on port 80) and the Vite dev
# server (port 5173) so the same .env works for `docker-compose up` and
# local `npm run dev`.
ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- AI services (ASR / LLM) ---
# ASR_SERVICE_API_KEY is REQUIRED for the worker to transcribe video -- set
# it to a real OpenAI API key (https://platform.openai.com/api-keys). Without
# it, processing fails clearly ("ASR_SERVICE_API_KEY is not configured")
# rather than hanging. ASR_SERVICE_BASE_URL/ASR_MODEL already default to
# OpenAI's real Whisper endpoint (api.openai.com, whisper-1) -- only
# override them to point at a different OpenAI-compatible provider.
ASR_SERVICE_API_KEY=
ASR_SERVICE_BASE_URL=https://api.openai.com
ASR_MODEL=whisper-1
# LLM_SERVICE_API_KEY is optional: without it, highlight selection falls
# back to a pure-Python heuristic detector (no external call, always works).
# Set a real OpenAI key to use the real LLM-based highlight detector instead.
LLM_SERVICE_API_KEY=
# Optional: path (inside the worker container) to a Netscape-format
# cookies.txt file, only needed if YouTube downloads fail with "Sign in to
# confirm you're not a bot" (common on some hosting providers' IP ranges --
# see docker-compose.yml's `worker` volume mount for how this gets there).
# NEVER commit a real cookies file; use a throwaway account's session, not
# your primary account's, since these cookies grant that account's access.
YOUTUBE_COOKIES_PATH=

# --- Media storage ---
MEDIA_STORAGE_PATH=/data/media
MEDIA_STORAGE_BACKEND=local

# --- Publishing platform OAuth credentials ---
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# NOTE: social publishing is MVP-disabled (stub integrations were removed in
# favor of a clear "not implemented" error) -- these are unused for now.
