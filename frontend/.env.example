# The app calls the API via a relative /api/v1 path (see src/services/api.ts).
# In Docker, nginx proxies /api to the backend service (see nginx.conf).
# For local `npm run dev`, vite.config.ts proxies /api to a local backend;
# override the target if it's not on the default http://localhost:8000:
# VITE_DEV_API_PROXY_TARGET=http://localhost:8000
